def configurar_bases_espectrais(L0_valor, N_valor):
    col = np.cos(np.arange(2*N_valor + 4)*math.pi /(2*N_valor + 3))  
    colr = col[1:N_valor+2]

    r1 = L0_valor * colr/(np.sqrt(1-colr**2))       
    r = np.flip(r1)

    SB = np.zeros([N_valor+3, N_valor+1])
    rSB = np.zeros([N_valor+3, N_valor+1])
    rrSB = np.zeros([N_valor+3, N_valor+1])

    for i in range(N_valor+1+1+1):
        SB[i,] = np.sin((2*i+1)*np.arctan(L0_valor/r))
        rSB[i,] = -np.cos((2*i+1)*np.arctan(L0_valor/r))*(2*i+1)*L0_valor/(r**2*(1+L0_valor**2/r**2))
        rrSB[i,] = -np.sin((2*i+1)*np.arctan(L0_valor/r))*(2*i+1)**2*L0_valor**2/(r**4*(1+L0_valor**2/r**2)**2)+2*np.cos((2*i+1)*np.arctan(L0_valor/r))*(2*i+1)*L0_valor/(r**3*(1+L0_valor**2/r**2))-2*np.cos((2*i+1)*np.arctan(L0_valor/r))*(2*i+1)*L0_valor**3/(r**5*(1+L0_valor**2/r**2)**2)

    psi = SB[0:N_valor+1, :]       
    rpsi = rSB[0:N_valor+1, :]
    rrpsi = rrSB[0:N_valor+1, :]
    inv_psi = np.linalg.inv(psi)

    SB2 = np.zeros([N_valor+1, N_valor+1])
    rSB2 = np.zeros([N_valor+1, N_valor+1])
    rrSB2 = np.zeros([N_valor+1, N_valor+1])

    for i in range(N_valor+1):
        SB2[i,] = np.sin((2*(i+1/2)+1)*np.arctan(L0_valor/r))
        rSB2[i,] = -np.cos((2*i+2)*np.arctan(L0_valor/r))*(2*i+2)*L0_valor/(r**2*(1+L0_valor**2/r**2))
        rrSB2[i,] = -np.sin((2*i+2)*np.arctan(L0_valor/r))*(2*i+2)**2*L0_valor**2/(r**4*(1+L0_valor**2/r**2)**2)+2*np.cos((2*i+2)*np.arctan(L0_valor/r))*(2*i+2)*L0_valor/(r**3*(1+L0_valor**2/r**2))-2*np.cos((2*i+2)*np.arctan(L0_valor/r))*(2*i+2)*L0_valor**3/(r**5*(1+L0_valor**2/r**2)**2)

    inv_SB2 = np.linalg.pinv(SB2)

    Nq = int(3/2*N_valor)
    gauss_quadrature = np.polynomial.legendre.leggauss(Nq + 1)
    new_col = gauss_quadrature[0]
    wq_col = gauss_quadrature[1] 
    rq = L0_valor*(1+new_col)/(1-new_col) 

    qSB = np.zeros([Nq+3, Nq+1])
    qrSB = np.zeros([Nq+3, Nq+1])
    qrrSB = np.zeros([Nq+3, Nq+1])

    for i in range(Nq+1+1+1):
        qSB[i,] = np.sin((2*i+1)*np.arctan(L0_valor/rq))
        qrSB[i,] = -np.cos((2*i+1)*np.arctan(L0_valor/rq))*(2*i+1)*L0_valor/(rq**2*(1+L0_valor**2/rq**2))
        qrrSB[i,] = -np.sin((2*i+1)*np.arctan(L0_valor/rq))*(2*i+1)**2*L0_valor**2/(rq**4*(1+L0_valor**2/rq**2)**2)+2*np.cos((2*i+1)*np.arctan(L0_valor/rq))*(2*i+1)*L0_valor/(rq**3*(1+L0_valor**2/rq**2))-2*np.cos((2*i+1)*np.arctan(L0_valor/rq))*(2*i+1)*L0_valor**3/(rq**5*(1+L0_valor**2/rq**2)**2)

    qpsi = qSB[0:N_valor+1, :]
    rqpsi = qrSB[0:N_valor+1, :]
    rrqpsi = qrrSB[0:N_valor+1, :]

    qSB2 = np.zeros([N_valor+1, Nq+1])
    rqSB2 = np.zeros([N_valor+1, Nq+1])

    for i in range(N_valor+1):
        qSB2[i,] = np.sin((2*(i+1/2)+1)*np.arctan(L0_valor/rq))
        rqSB2[i,] = -np.cos((2*i+2)*np.arctan(L0_valor/rq))*(2*i+2)*L0_valor/(rq**2*(1+L0_valor**2/rq**2))

    return {
        'r': r, 'psi': psi, 'rpsi': rpsi, 'rrpsi': rrpsi, 'inv_psi': inv_psi,
        'SB2': SB2, 'rSB2': rSB2, 'rrSB2': rrSB2, 'inv_SB2': inv_SB2,
        'rq': rq, 'wq_col': wq_col, 'qpsi': qpsi, 'rqpsi': rqpsi, 'rrqpsi': rrqpsi,
        'qSB2': qSB2, 'rqSB2': rqSB2,
        'L0': L0_valor, 'N': N_valor
    }

def criar_condicoes_iniciais(A0_valor, bases):
    r = bases['r']
    psi = bases['psi']
    rpsi = bases['rpsi']
    rrpsi = bases['rrpsi']
    inv_psi = bases['inv_psi']
    N_valor = bases['N']
    
    r0 = 2.0
    sigma = 1.0

    # Gaussian pulse para o campo escalar
    Phi_0 = A0_valor*r**2*(np.exp(-(r-r0)**2/sigma**2)+np.exp(-(r+r0)**2/sigma**2))
    a0 = np.dot(Phi_0, inv_psi)
    Pi_0 = np.zeros(N_valor+1)
    b0 = np.dot(Pi_0, inv_psi) 

    c0 = 0.001 * np.ones([N_valor+1]) 
    rPhi= np.dot(a0, rpsi)

    # Newton-Raphson para resolver a restrição Hamiltoniana inicial
    tol = 1e-18
    for n in range(51):
        Chi = np.dot(c0, psi)
        rChi = np.dot(c0, rpsi)
        rrChi = np.dot(c0, rrpsi)
        H0 = 4*rChi**2 + 4*rrChi + 8/r*rChi + 0.5*(rPhi)**2
        JH = 8*np.dot(c0, rpsi)*rpsi + 4*rrpsi + 8/r*rpsi
        
        cnew = c0 - np.linalg.lstsq(JH.T, H0, rcond=None)[0]
        if min(abs(cnew - c0)) < tol:
            break
        c0 = cnew

    theta0 = np.zeros(N_valor+1)
    z0 = np.zeros(N_valor+1)
    return c0, a0, b0, theta0, z0

def calcular_taxas(c_coefs, a_coefs, b_coefs, theta_coefs, z_coefs, formalismo, kappa1, kappa2, bases):
    psi = bases['psi']; rpsi = bases['rpsi']; rrpsi = bases['rrpsi']; inv_psi = bases['inv_psi']
    SB2 = bases['SB2']; rSB2 = bases['rSB2']; inv_SB2 = bases['inv_SB2']
    r = bases['r']
    
    Chi = np.dot(c_coefs, psi)
    rChi = np.dot(c_coefs, rpsi)
    rrChi = np.dot(c_coefs, rrpsi)
    Phi = np.dot(a_coefs, psi)
    rPhi = np.dot(a_coefs, rpsi)
    rrPhi = np.dot(a_coefs, rrpsi)
    Pi = np.dot(b_coefs, psi)
    rPi = np.dot(b_coefs, rpsi) 
    Theta = np.dot(theta_coefs, psi)
    rTheta = np.dot(theta_coefs, rpsi)
    Z = np.dot(z_coefs, SB2)
    rZ = np.dot(z_coefs, rSB2)

    # ADM Puro: Z e Theta são estritamente nulos
    if formalismo == 'ADM':
        Theta = np.zeros_like(Theta)
        rTheta = np.zeros_like(rTheta)
        Z = np.zeros_like(Z)
        rZ = np.zeros_like(rZ)

    McK = 6 * rChi * psi + rpsi + 3 * (1/r) * psi
    RHS_K = -Pi * rPhi
    ck0 = np.linalg.lstsq(McK.T, RHS_K, rcond=None)[0]
    Krr = np.dot(ck0, psi)
    rKrr = np.dot(ck0, rpsi)

    Mal = rrpsi + 2 * (1/r + rChi) * rpsi \
          - 1.5 * np.exp(4*Chi) * (Krr**2) * psi \
          - np.exp(4*Chi) * (Pi**2) * psi \
          - 2 * rZ * psi \
          - 2 * (2*rChi + 2/r) * Z * psi \
          + 3 * kappa1 * (1 + kappa2) * Theta * psi
          
    rhsal = 1.5 * np.exp(4*Chi) * Krr**2 + np.exp(4*Chi) * Pi**2 \
            + 2 * rZ + 2 * (2*rChi + 2/r) * Z - 3 * kappa1 * (1 + kappa2) * Theta
             
    al0 = np.linalg.lstsq(Mal.T, rhsal, rcond=None)[0]
    Alpha = 1 + np.dot(al0, psi)
    rAlpha = np.dot(al0, rpsi)

    Mbe = rSB2 - SB2 * (1/r)
    rhsbe = 1.5 * Alpha * Krr
    be0 = np.linalg.lstsq(Mbe.T, rhsbe, rcond=None)[0]
    Beta = np.dot(be0, SB2)
    rBeta = np.dot(be0, rSB2)
    
    dChi_dt = np.dot(Beta * rChi + Beta / (2*r) + 0.25 * Alpha * Krr, inv_psi)
    dPhi_dt = np.dot(Alpha * Pi + Beta * rPhi, inv_psi)
    dPi_dt_expr = (Beta*rPi + np.exp(-4*Chi)*rPhi*(2*Alpha/r + rAlpha + 2*Alpha*rChi) + np.exp(-4*Chi)*Alpha*rrPhi)
    dPi_dt = np.dot(dPi_dt_expr, inv_psi)
    
    R = -8 * np.exp(-4*Chi) * (rrChi + rChi**2 + 2*rChi/r)

    # Z4 Evolutions
    dTheta_dt_expr = Beta * rTheta + 0.5 * Alpha * (R - 1.5*Krr**2 - Pi**2 - np.exp(-4*Chi)*rPhi**2) \
                     - np.exp(-4*Chi) * Z * rAlpha + Alpha * (rZ + (6*rChi + 2/r)*Z) * np.exp(-4*Chi) \
                     - kappa1 * (kappa2 + 2) * Alpha * Theta
    dtheta_dt = np.dot(dTheta_dt_expr, inv_psi)

    Mc = rKrr + 6*Krr*rChi + 3*Krr/r + Pi*rPhi
    dZ_dt_expr = Beta * rZ + Z * rBeta + Alpha * Mc - 2 * Alpha * Z * Krr \
                 + Alpha * rTheta - Theta * rAlpha - kappa1 * Alpha * Z
    dz_dt = np.dot(dZ_dt_expr, inv_SB2)

    if formalismo == 'ADM':
        dtheta_dt = np.zeros_like(theta_coefs)
        dz_dt = np.zeros_like(z_coefs)
        
    return dChi_dt, dPhi_dt, dPi_dt, dtheta_dt, dz_dt, ck0

def passo_rk4(c0, a0, b0, theta0, z0, h, formalismo, kappa1, kappa2, bases):
    K1_rc, K1_ra, K1_rb, K1_rtheta, K1_rz, _ = calcular_taxas(c0, a0, b0, theta0, z0, formalismo, kappa1, kappa2, bases)
    K1 = h * K1_rc; L1 = h * K1_ra; N1 = h * K1_rb; dtheta1 = h * K1_rtheta; dz1 = h * K1_rz

    K2_rc, K2_ra, K2_rb, K2_rtheta, K2_rz, _ = calcular_taxas(c0+K1/2, a0+L1/2, b0+N1/2, theta0+dtheta1/2, z0+dz1/2, formalismo, kappa1, kappa2, bases)
    K2 = h * K2_rc; L2 = h * K2_ra; N2 = h * K2_rb; dtheta2 = h * K2_rtheta; dz2 = h * K2_rz

    K3_rc, K3_ra, K3_rb, K3_rtheta, K3_rz, _ = calcular_taxas(c0+K2/2, a0+L2/2, b0+N2/2, theta0+dtheta2/2, z0+dz2/2, formalismo, kappa1, kappa2, bases)
    K3 = h * K3_rc; L3 = h * K3_ra; N3 = h * K3_rb; dtheta3 = h * K3_rtheta; dz3 = h * K3_rz

    K4_rc, K4_ra, K4_rb, K4_rtheta, K4_rz, _ = calcular_taxas(c0+K3, a0+L3, b0+N3, theta0+dtheta3, z0+dz3, formalismo, kappa1, kappa2, bases)
    K4 = h * K4_rc; L4 = h * K4_ra; N4 = h * K4_rb; dtheta4 = h * K4_rtheta; dz4 = h * K4_rz

    return (c0 + (K1 + 2*K2 + 2*K3 + K4)/6,
            a0 + (L1 + 2*L2 + 2*L3 + L4)/6,
            b0 + (N1 + 2*N2 + 2*N3 + N4)/6,
            theta0 + (dtheta1 + 2*dtheta2 + 2*dtheta3 + dtheta4)/6,
            z0 + (dz1 + 2*dz2 + 2*dz3 + dz4)/6)

def executar_simulacao(formalismo, A0_valor, h, tf, kappa1, kappa2, L0, N):
    print(f" -> Rodando {formalismo} | N = {N} | A0 = {A0_valor} | k1 = {kappa1}")
    bases = configurar_bases_espectrais(L0, N)
    c_atual, a_atual, b_atual, theta_atual, z_atual = criar_condicoes_iniciais(A0_valor, bases)
    
    qpsi = bases['qpsi']; rqpsi = bases['rqpsi']; rrqpsi = bases['rrqpsi']
    wq_col = bases['wq_col']; rq = bases['rq']
    
    Time_data, L2HC_data = [], []
    t_atual = 0.0
    idump = 500
    niter = 0
    
    while t_atual <= tf:
        if niter % idump == 0:
            _, _, _, _, _, ck0 = calcular_taxas(c_atual, a_atual, b_atual, theta_atual, z_atual, formalismo, kappa1, kappa2, bases)
            
            qPhi = np.dot(a_atual, qpsi)
            rqPhi = np.dot(a_atual, rqpsi)
            qPi = np.dot(b_atual, qpsi)
            qChi = np.dot(c_atual, qpsi)
            rqChi = np.dot(c_atual, rqpsi)
            rrqChi = np.dot(c_atual, rrqpsi)
            Krrq = np.dot(ck0, qpsi)

            Rq = -8 * np.exp(-4*qChi) * (rrqChi + rqChi**2 + 2*rqChi/rq)
            HCq = Rq - 1.5 * Krrq**2 - qPi**2 - np.exp(-4*qChi) * rqPhi**2
            L2HC = np.sqrt(0.5 * np.dot(HCq**2, wq_col))
            
            Time_data.append(t_atual)
            L2HC_data.append(L2HC)
            
            if np.isnan(L2HC) or L2HC > 100.0:
                print(f"    [CRASH] Simulação estourou em t={t_atual:.2f}")
                break

        c_atual, a_atual, b_atual, theta_atual, z_atual = passo_rk4(
            c_atual, a_atual, b_atual, theta_atual, z_atual, h, formalismo, kappa1, kappa2, bases
        )
        
        t_atual += h
        niter += 1

    return np.array(Time_data), np.array(L2HC_data)

